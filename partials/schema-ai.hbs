{{!-- Extra JSON-LD beside Ghost Article: breadcrumbs + opt-in HowTo/FAQ via internal tags --}}
{{#is "post"}}
{{#post}}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "{{@site.title}}",
          "item": "{{@site.url}}/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "{{title}}",
          "item": "{{url absolute="true"}}"
        }
      ]
    }
    {{#has tag="#howto"}},
    {
      "@type": "HowTo",
      "name": "{{title}}",
      "description": "{{#if meta_description}}{{meta_description}}{{else}}{{excerpt}}{{/if}}",
      "url": "{{url absolute="true"}}",
      "inLanguage": "{{@site.locale}}",
      {{#if feature_image}}"image": "{{img_url feature_image absolute="true"}}",{{/if}}
      "step": [
        {
          "@type": "HowToStep",
          "name": "{{title}}",
          "url": "{{url absolute="true"}}",
          "text": "{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt}}{{/if}}"
        }
      ]
    }
    {{/has}}
    {{#has tag="#faq"}},
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "{{title}}",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "{{#if meta_description}}{{meta_description}}{{else}}{{excerpt}}{{/if}}"
          }
        }
      ]
    }
    {{/has}}
  ]
}
</script>
{{/post}}
{{/is}}
