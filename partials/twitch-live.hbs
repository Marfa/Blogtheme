{{!-- Floating Twitch preview (marfapr) — visible only while the channel is live --}}
<aside class="twitch-live" id="twitch-live" aria-label="Twitch live" hidden>
  <div class="twitch-live__bar">
    <a class="twitch-live__link" href="https://www.twitch.tv/marfapr" target="_blank" rel="noopener noreferrer">
      <span class="twitch-live__dot" aria-hidden="true"></span>
      LIVE · marfapr
    </a>
    <button type="button" class="twitch-live__close" id="twitch-live-close" aria-label="{{t "Close"}}">
      {{> icon name="x" size="xs"}}
    </button>
  </div>
  <div class="twitch-live__frame">
    <div id="twitch-live-player"></div>
  </div>
</aside>

<script>
(function () {
  var CHANNEL = 'marfapr';
  var DISMISS_KEY = 'twitch-live-dismissed:' + CHANNEL;
  var widget = document.getElementById('twitch-live');
  var closeBtn = document.getElementById('twitch-live-close');

  if (!widget || sessionStorage.getItem(DISMISS_KEY)) return;

  function hide() {
    widget.hidden = true;
    widget.classList.remove('is-live');
  }

  function show() {
    widget.hidden = false;
    widget.classList.add('is-live');
  }

  function handleClose() {
    sessionStorage.setItem(DISMISS_KEY, '1');
    hide();
  }

  if (closeBtn) closeBtn.addEventListener('click', handleClose);

  function bootPlayer() {
    if (typeof Twitch === 'undefined' || !Twitch.Player) return;

    var player = new Twitch.Player('twitch-live-player', {
      width: 400,
      height: 300,
      channel: CHANNEL,
      parent: [window.location.hostname],
      autoplay: true,
      muted: true
    });

    player.addEventListener(Twitch.Player.ONLINE, show);
    player.addEventListener(Twitch.Player.OFFLINE, hide);
  }

  var script = document.createElement('script');
  script.src = 'https://player.twitch.tv/js/embed/v1.js';
  script.async = true;
  script.onload = bootPlayer;
  document.body.appendChild(script);
})();
</script>
