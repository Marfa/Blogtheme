{{!-- Related posts → same tag; fallback → recent (keeps internal links on indexable HTML URLs) --}}
{{#get "posts" include="tags,authors" limit="3" filter="id:-{{comment_id}}+tag:{{primary_tag.slug}}" as |related|}}
  {{#if related}}
    <div class="related-posts m-t-lg">
      <div class="container wrapper">
        <div class="section__title m-b">{{t "You might also like"}}</div>
        <div class="row post-container">
          {{#foreach related}}
            <div class="col-xs-12 col-md-6 col-lg-4 m-b-lg">
              {{> post-card class="h-100"}}
            </div>
          {{/foreach}}
        </div>
      </div>
    </div>
  {{else}}
    {{#get "posts" include="tags,authors" limit="3" filter="id:-{{comment_id}}" as |recent|}}
      {{#if recent}}
        <div class="related-posts m-t-lg">
          <div class="container wrapper">
            <div class="section__title m-b">{{t "You might also like"}}</div>
            <div class="row post-container">
              {{#foreach recent}}
                <div class="col-xs-12 col-md-6 col-lg-4 m-b-lg">
                  {{> post-card class="h-100"}}
                </div>
              {{/foreach}}
            </div>
          </div>
        </div>
      {{/if}}
    {{/get}}
  {{/if}}
{{/get}}
