{{!-- Artalk comments --}}
<link href="https://comments.themarfa.name/dist/Artalk.css" rel="stylesheet">
<style>
    /* MIT allows omitting UI credit; license text stays in upstream source. */
    .artalk .atk-list-footer .atk-copyright { display: none !important; }
</style>
<script src="https://comments.themarfa.name/dist/Artalk.js"></script>
<div id="artalk-comments" class="m-t"></div>
<script>
    Artalk.init({
        el: '#artalk-comments',
        pageKey: '{{url}}',
        pageTitle: '{{title}}',
        server: 'https://comments.themarfa.name',
        site: 'All-in-One Person'
    });
</script>
