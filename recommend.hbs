{{!< default}}

{{#contentFor "head"}}
    <meta name="robots" content="noindex, follow">
    {{#if @site.cover_image}}
        <meta property="og:image" content="{{img_url @site.cover_image size='xl'}}">
        <meta name="twitter:image" content="{{img_url @site.cover_image size='xl'}}">
    {{else if @site.logo}}
        <meta property="og:image" content="{{img_url @site.logo size='l'}}">
        <meta name="twitter:image" content="{{img_url @site.logo size='l'}}">
    {{/if}}
    {{#if @site.description}}
        <meta property="og:description" content="{{@site.description}}">
        <meta name="twitter:description" content="{{@site.description}}">
    {{/if}}
{{/contentFor}}

{{#match @site.recommendations_enabled}}
  <div class="container wrapper">
    {{!-- Hero --}}
    {{#page}}
      {{> page-hero hero_class="side"}}
    {{else}}
      <div class="post-hero is-page side" data-feature-image="false">
        <div class="post-hero__content flex flex-col">
          <h1 class="post-hero__title text-center m-b">{{t "Recommendations"}}</h1>
        </div>
      </div>
    {{/page}}

    <div class="content-width flex flex-col">
      {{recommendations}}
      <button data-portal="recommendations" class="btn flex items-center self-align-center m-b-xl">
        <span class="mr-sm">{{t "Show all recommendations"}}</span>
        {{> icon name="arrow-right" size="sm"}}
      </button>
    </div>
  </div>
{{/match}}
